#!/usr/bin/env ruby
# frozen_string_literal: true

# Live smoke test against the next API.
#
#   bin/smoke                         # public endpoints only
#   OCTA_API_KEY=octa_ak_… bin/smoke  # plus the read-only authenticated ones
#   OCTA_API_KEY=octa_ak_… bin/smoke --compute M95S-WZG8-7
#       # plus a paid round trip on that node: start a tiny alpine session,
#       # wait until ready, read its logs, stop it and wait until it is gone
#
# OCTA_API_URL overrides the base URL (default: https://api-dev.octa.space).
# Exits with status 1 when any check fails.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "octaspace"

compute_node = (i = ARGV.index("--compute")) && ARGV[i + 1]
abort "usage: bin/smoke [--compute NODE_NUMBER]" if ARGV.include?("--compute") && compute_node.nil?

options = {}
options[:base_url] = ENV["OCTA_API_URL"] if ENV["OCTA_API_URL"].to_s.strip != ""
client = OctaSpace::Client.new(api_key: ENV["OCTA_API_KEY"], **options)
authenticated = !ENV["OCTA_API_KEY"].to_s.strip.empty?
failures = 0

check = lambda do |name, &block|
  detail = block.call
  puts "ok    #{name}#{" — #{detail}" if detail}"
rescue OctaSpace::Error => e
  failures += 1
  puts "FAIL  #{name} — #{e.class}: #{e.message}"
end

puts "OctaSpace Ruby SDK #{OctaSpace::VERSION} → #{options[:base_url] || OctaSpace::DEFAULT_BASE_URL}"

check.call("network.info") { "#{client.network.info.nodes.online} nodes online" }
check.call("stats.gpu_current") { "#{client.stats.gpu_current.gpus.size} GPU models" }
check.call("stats.gpu_history") { "#{client.stats.gpu_history.size} models" }
check.call("stats.gpu_locations") { "#{client.stats.gpu_locations.size} locations" }
check.call("compute.list") { "#{client.compute.list.size} machines" }
check.call("render.list") { "#{client.render.list.size} nodes" }

if authenticated
  check.call("accounts.balance") { client.accounts.balance.formatted }
  check.call("sessions.list") { "#{client.sessions.list.size} running" }
  check.call("hosting.nodes") { "#{client.hosting.nodes.size} online nodes" }
else
  puts "skip  authenticated checks (OCTA_API_KEY is not set)"
end

if compute_node
  abort "--compute needs OCTA_API_KEY" unless authenticated

  uuid = nil
  begin
    check.call("compute.start") do
      uuid = client.compute.start(node_number: compute_node, image: "alpine:3.20", disk_size: 1,
        entrypoint: "sh -c", args: "\"echo octaspace-ruby-smoke; sleep 600\"")
    end
    if uuid
      check.call("sessions.wait_ready") { client.sessions.wait_ready(uuid, timeout: 300).status }
      check.call("sessions.logs") { "#{client.sessions.logs(uuid, tail: 10).system.size} system events" }
    end
  ensure
    # Always stop the session this script started, and only that one.
    if uuid
      check.call("sessions.stop") { client.sessions.stop(uuid) }
      check.call("sessions.wait_stopped") { client.sessions.wait_stopped(uuid, timeout: 120) && "gone" }
    end
  end
end

puts(failures.zero? ? "all checks passed" : "#{failures} check(s) failed")
exit(failures.zero? ? 0 : 1)
